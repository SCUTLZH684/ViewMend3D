*.sh text eol=lf
*.py text eol=lf
# A unified diff prefixes blank context lines with one space.
*.patch text eol=lf whitespace=-blank-at-eol
# Preserve upstream release files, including their original whitespace.
web/vendor/*.js -whitespace
# Preserve the audited v2 JSON bytes across Windows and Linux clones.
docs/reproduction/evidence/optimization-v2-*.json text eol=lf
docs/reproduction/evidence/optimization-v2-*.svg text eol=lf -whitespace
web/data/optimization-v2-summary.json text eol=lf
web/v2-results*.js text eol=lf
web/v2-results.css text eol=lf
